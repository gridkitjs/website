# GitHub source for docs content (packages/*/docs in the gridkit repo).
# The branch is only used by the per-file fallback and for edit links.
DOCS_GITHUB_OWNER=gridkitjs
DOCS_GITHUB_REPO=gridkitjs
DOCS_GITHUB_BRANCH=main

# Branch (or any git ref) in that repo holding docs-manifest.json, which
# gridkit's revalidate-docs workflow publishes. A manual workflow run from
# another branch publishes to docs-meta-<branch>; point this at it to preview.
DOCS_MANIFEST_REF=docs-meta

# Local dev only: read the manifest from this file instead of GitHub, to
# preview gridkit docs before pushing them. Build one in the gridkit repo with
# `node scripts/build-docs-manifest.mjs <path>`. Leave unset on Vercel.
# DOCS_MANIFEST_FILE=

# Required for `npm run build` and on Vercel. The manifest comes through the
# rate-limited GitHub API, and the per-file fallback used while none is
# published makes ~57 requests per uncached render, more than GitHub's
# unauthenticated limit of 60 requests/hr. A token raises it to 5,000/hr.
GITHUB_TOKEN=

# Shared secret for POST /api/revalidate-docs — must match the
# DOCS_REVALIDATE_SECRET repo secret used by gridkit's revalidate-docs.yml.
DOCS_REVALIDATE_SECRET=

NEXT_PUBLIC_SITE_URL=https://gridkitjs.com
