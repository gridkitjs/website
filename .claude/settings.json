{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run lint *)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(node scripts/gen-example-sources.mjs)",
      "Bash(node scripts/export-mdx-tags.mjs)",
      "Bash(node scripts/check-feature-slugs.mjs)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)"]
  }
}
